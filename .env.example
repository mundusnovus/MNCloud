# Copy to an ignored .env for local runs; Railway holds the real values.
PUBLIC_URL=http://localhost:8090
DATA_DIR=.data
# Sign-in with a Asteria account (Social's OpenID Connect provider)
OIDC_ISSUER=https://social.asteria.technology
OIDC_CLIENT_ID=asteria-cloud
OIDC_CLIENT_SECRET=
SESSION_SECRET=
# File contents. Leave S3_BUCKET empty to keep files in DATA_DIR/blobs instead.
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_REGION=auto
# Asteria Office
OFFICE_URL=https://office.asteria.technology
OFFICE_JWT_SECRET=
# Social: contacts and share records on the PDS
SOCIAL_URL=https://social.asteria.technology
SERVICE_SECRET=
QUOTA_GB=3
CAPACITY_GB=256
